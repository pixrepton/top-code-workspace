{
  "mcpServers": {
    "openmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@openmem/mcp@0.2.0"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser=firefox",
        "--allowed-hosts",
        "www.topinstal.com.pl,topinstal.com.pl,127.0.0.1,localhost"
      ]
    },
    "serena": {
      "command": "C:\\Users\\compg\\.local\\bin\\serena.exe",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "${workspaceFolder}"
      ]
    },
    "gitnexus": {
      "command": "gitnexus",
      "args": [
        "mcp"
      ]
    },
    "codebase-memory": {
      "command": "uvx",
      "args": [
        "codebase-memory-mcp"
      ]
    }
  }
}
