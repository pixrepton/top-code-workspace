{
  "mcpServers": {
    "codebase-memory": {
      "command": "uvx",
      "args": [
        "--from",
        "codebase-memory-mcp==0.9.0",
        "codebase-memory-mcp"
      ]
    },
    "gitnexus": {
      "command": "gitnexus",
      "args": [
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78"
      ]
    },
    "codescene": {
      "command": "npx",
      "args": [
        "-y",
        "@codescene/codehealth-mcp@1.4.1"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.2.5"
      ]
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    }
  }
}
