# Copy to .env.daszek-local (gitignored). Loaded by docker-compose.daszek-local.yml (required: false).
#
# Mirror secrets from gmail-agent/tools/gmail_audit/.env when testing Skrzat proxy or Node B → WP push:
#   NODE_B_REGISTRY_TOKEN       →  DASZEK_NODE_B_API_TOKEN
#   DASZEK_BRIDGE_TOKEN         →  DASZEK_BRIDGE_TOKEN
#   DASZEK_NODE_B_SERVICE_TOKEN →  DASZEK_NODE_B_SERVICE_TOKEN  (feed/ingress POST; may equal bridge locally)
#
# Node B URL is fixed in compose WORDPRESS_CONFIG_EXTRA:
#   DASZEK_NODE_B_API_BASE=http://host.docker.internal:8766

DASZEK_NODE_B_API_TOKEN=
DASZEK_BRIDGE_TOKEN=
DASZEK_NODE_B_SERVICE_TOKEN=
