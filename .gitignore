# TOP-INSTAL workspace meta-repo — ignore junk only.
# Nested product repos are separate Git units; do not hide them from search or status.
# Never use `git add -A` from root; stage via task-commit with explicit paths.

# Dependency trees and runtime caches
**/node_modules/
**/vendor/
**/.venv/
**/dist/
**/build/
**/__pycache__/
**/.pytest_cache/
**/coverage/
**/playwright-report/
**/test-results/
**/.agent-tooling-cache/

# Local runtime / work artifacts
**/.artifacts/
**/.worktrees/
**/.runtime-wp/

# Secrets — never index or commit
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Tooling indexes (regenerate on demand; not product sources)
**/.gitnexus/
**/.serena/cache/
**/.serena/logs/
**/.serena/memories/

# Operator chat exports / one-off scratch at workspace root
/ChatGPT*.md
/scripts/_tmp_*.py

# Generated audit / test-run artifacts (junk, not product sources)
docs/*.html
/tools/**/runs/

# Nested independent Git repos live here; each has its own .git unit.
# Root meta-repo must never stage/commit them (see AGENTS.md); ignore at root index only.
/cieplo-orchestrator/
/daszek/
/fast-kalk/
/gmail-agent/
/kalk-top/
/knowledge/
/rag-chat-asystent/
/rag-widget/
/top-instal-generator/

# Root-local operator scratch (not harness, not nested product repos)
/archive-codex-and-claude/
/_review_bundle/
/_review_current/
/.playwright-mcp/
/.vscode/
/.claude/settings.local.json*
/.codex/
/*.png
/SUFITY.md
/czat.md

/*.log
/.tmp-cookies.txt
/ctfu5-browser-*.png
/.mcp.json.backup-*
/tmp/
/.pytest_cache/
/.ruff_cache/

# Cursor local operator config (not harness policy)
/.cursor/plans/
/.cursor/hooks.json.backup*
/.cursor/settings.json
/.cursor/permissions.json

# Payload stub: only AGENTS.md is tracked at workspace root
payload/**
!payload/AGENTS.md
