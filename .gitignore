# TOP-INSTAL workspace meta-repo (sparse): harness + agent rules + local compose.
*

!.gitignore
!AGENTS.md
!.cbmignore
!.serena/
!.serena/project.yml
!.serena/.gitignore
!wp-bridges/
!wp-bridges/.cbmignore
!wp-bridges/.serena/
!wp-bridges/.serena/project.yml
!wp-bridges/.serena/.gitignore
!scripts/
!scripts/**
!.agents/
!.agents/skills/
!.agents/skills/**
!docker-compose.cieplo-local.yml
!docker-compose.kalk-top-local.yml
!docker-compose.daszek-local.yml
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc
!.cursor/mcp.json
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/*.js
!.cursor/hooks/lib/
!.cursor/hooks/lib/*.js
!.cursorignore
!.mcp.json
!.claude/
/.claude/*
!/.claude/settings.json
!/.claude/agents/
!/.claude/agents/**
!/.claude/hooks/
!/.claude/hooks/**
!/.claude/rules/
!/.claude/rules/**
!/.claude/skills/
!/.claude/skills/**
!/.claude/commands/
!/.claude/commands/**
!CLAUDE.md
!workspace-repos.lock.json
!.github/
!.github/workflows/
!.github/workflows/*.yml
!top-code.code-workspace

# Re-ignore generated Python bytecode caches inside otherwise-tracked scripts/
# (this file is a sparse allowlist starting from '*', and !scripts/** un-ignores
# everything under scripts/ recursively, including __pycache__).
scripts/**/__pycache__/
scripts/**/*.pyc

# Root hygiene: keep session junk / proof dumps out of the workspace root even if
# a later allowlist entry accidentally un-ignores them.
/monitor.log
/*.log
/.tmp-cookies.txt
/ctfu5-browser-*.png
/.mcp.json.backup-*
/tmp/
/.artifacts/
/.pytest_cache/
/.ruff_cache/
