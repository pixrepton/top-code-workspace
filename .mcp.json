{
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "codebase-memory-mcp==0.9.0",
        "codebase-memory-mcp"
      ],
      "env": {
        "CBM_ALLOWED_ROOT": "C:/Users/compg/Desktop/top-code workspace",
        "CBM_CACHE_DIR": "C:/ai-os-codebase-memory"
      }
    },
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": [
        "mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx.cmd -y @playwright/mcp@0.0.78"
      ]
    },
    "codescene": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx.cmd -y @codescene/codehealth-mcp@1.4.1"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx.cmd -y @upstash/context7-mcp@3.2.5"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    }
  }
}
