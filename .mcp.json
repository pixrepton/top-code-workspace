{
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "codebase-memory-mcp==0.9.0",
        "codebase-memory-mcp"
      ],
      "env": {
        "CBM_ALLOWED_ROOT": "C:/Users/compg/Desktop/top-code workspace/gmail-agent",
        "CBM_CACHE_DIR": "C:/ai-os-codebase-memory"
      }
    },
    "codescene": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx.cmd -y @codescene/codehealth-mcp"
      ],
      "env": {
        "CS_DISABLE_VERSION_CHECK": "1",
        "CS_ENABLED_TOOLS": "explain_code_health,explain_code_health_productivity,code_health_review,code_health_score,pre_commit_code_health_safeguard,analyze_change_set,code_health_refactoring_business_case,verify_installation,get_config"
      }
    }
  }
}
