{
  "version": 2,
  "canonical_mailbox": {
    "database_names": ["mailbox_memory"],
    "hosts": ["mailbox-memory-db", "127.0.0.1", "localhost"]
  },
  "repos": {
    "gmail-agent": ["mailbox_memory", "mailbox_memory_asof", "mailbox_memory_test", "neo4j_graph"],
    "rag-chat-asystent": ["graphstore", "pgvector", "chroma"],
    "cieplo-orchestrator": ["cieplo_database"]
  },
  "stores": [
    {
      "id": "mailbox_memory",
      "env": "MAILBOX_MEMORY_DATABASE_URL",
      "kind": "postgres",
      "repos": ["gmail-agent"]
    },
    {
      "id": "mailbox_memory_asof",
      "env": "MAILBOX_MEMORY_ASOF_DATABASE_URL",
      "kind": "postgres",
      "repos": ["gmail-agent"]
    },
    {
      "id": "mailbox_memory_test",
      "env": "MAILBOX_MEMORY_TEST_DATABASE_URL",
      "kind": "postgres",
      "repos": ["gmail-agent"],
      "forced_read_only": "1"
    },
    {
      "id": "neo4j_graph",
      "env": "NEO4J_URI",
      "kind": "neo4j",
      "repos": ["gmail-agent"],
      "forced_read_only": "1"
    },
    {
      "id": "graphstore",
      "env": "GRAPHSTORE_URL",
      "kind": "postgres",
      "repos": ["rag-chat-asystent"]
    },
    {
      "id": "pgvector",
      "env": "PGVECTOR_DATABASE_URL",
      "kind": "postgres",
      "repos": ["rag-chat-asystent"]
    },
    {
      "id": "chroma",
      "env": "CHROMA_HOST",
      "kind": "chroma",
      "repos": ["rag-chat-asystent"],
      "forced_read_only": "1"
    },
    {
      "id": "cieplo_database",
      "env": "DATABASE_URL",
      "kind": "postgres",
      "repos": ["cieplo-orchestrator"]
    },
    {
      "id": "database_url_global",
      "env": "DATABASE_URL",
      "kind": "postgres",
      "repos": ["gmail-agent", "cieplo-orchestrator"]
    }
  ]
}
